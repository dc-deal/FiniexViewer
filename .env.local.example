# Backend API base URL.
# The Vite dev proxy forwards all /api/* requests to this target so the browser
# never crosses origins. Copy this file to .env.local and adjust as needed.
#
# Inside Docker Compose (default): use the compose service name.
VITE_API_BASE_URL=http://finiex-dev:8000
#
# Host-only dev (no Docker): use localhost.
# VITE_API_BASE_URL=http://localhost:8000

# Bearer token for the backend API, once it requires one.
# Leave it unset and no Authorization header is sent — the previous behaviour.
#
# NOTE THE MISSING VITE_ PREFIX, and do not add one. A VITE_* variable is inlined
# into the client bundle at build time, which would publish the token to anyone who
# opens the page. This one is read by the dev proxy in the Node process and attached
# to the outgoing request; the browser never receives it.
#
# FINIEX_API_TOKEN=
