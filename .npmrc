# Playwright ships its browsers as glibc builds. This container is Alpine on musl (measured
# 2026-09-28: Alpine 3.23.4, musl 1.2.5), so a downloaded Chromium here cannot start — the install
# would spend a gigabyte producing something unusable, and on a rebuild it would do it again.
#
# The browser lives on the developer's machine instead and is driven over CDP; see
# e2e/cdp_fixture.ts for what that needs. This line is here rather than in a runbook because an
# instruction somebody has to remember is one a rebuild will eventually forget.
playwright_skip_browser_download=1
